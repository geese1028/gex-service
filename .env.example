# IB Gateway via NautilusTrader HistoricInteractiveBrokersClient.
# Defaults match the adapter: paper Gateway 4002, client_id 1.
# 4002 = paper API, 4001 = live API. TWS paper/live are 7497/7496.
# If the Gateway runs on another host and only trusts 127.0.0.1, open a tunnel:
#   ssh -N -L 14002:127.0.0.1:4002 user@gateway-host
# and set GEX_IB_PORT=14002 here.
GEX_IB_HOST=127.0.0.1
GEX_IB_PORT=4002
GEX_IB_CLIENT_ID=1
GEX_IB_CONNECT_TIMEOUT_S=60
GEX_IB_REQUEST_TIMEOUT_S=120
GEX_HISTORICAL_REQUEST_DELAY_S=1
GEX_HISTORICAL_TIMEOUT_S=120
GEX_MAX_MD_LINES=100

# HTTP API. Loopback-only by default; reach it through an SSH tunnel or a reverse proxy.
GEX_API_HOST=127.0.0.1
GEX_API_PORT=8090
# Optional. Empty disables the X-API-Key check.
GEX_API_KEY=
# Comma-separated list of allowed CORS origins ("*" allows all).
GEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chain selection defaults (overridable per request).
GEX_MAX_DTE=45
GEX_STRIKE_RANGE_PCT=0.12
GEX_MAX_CONTRACTS=1500

# IB market-data line budget (this process is the only RTH consumer).
GEX_BATCH_SIZE=100
GEX_BATCH_WAIT_S=3.0
GEX_BATCH_MIN_WAIT_S=1.0
GEX_BATCH_SLEEP_S=0.5
GEX_DETAILS_CONCURRENCY=4
GEX_REFRESH_INTERVAL_S=90
GEX_FETCH_TIMEOUT_S=180
GEX_IDLE_TTL_S=1800

# Pricing inputs for the Black-Scholes gamma used in the zero-gamma scan.
GEX_RISK_FREE_RATE=0.045
GEX_DIVIDEND_YIELD=0.0

# 1 = live, 2 = frozen, 3 = delayed, 4 = delayed-frozen. Outside RTH the
# service switches to frozen automatically when GEX_AUTO_FROZEN=true.
GEX_MARKET_DATA_TYPE=1
GEX_AUTO_FROZEN=true

# Snapshot store.
GEX_DB_PATH=data/gex.sqlite
GEX_SNAPSHOT_RETENTION_DAYS=14

# Extensions
# ET clock; the last snapshot at or before 16:00 ET is archived once per session.
GEX_EOD_ARCHIVE_TIME=16:05
# Heuristic share of today's option volume treated as opening new OI (calibrated by next-day reconcile).
GEX_OI_OPENING_RATIO=0.5
# Lee-Ready flow tracking: max symbols and ATM strikes per side.
GEX_FLOW_MAX_SYMBOLS=2
GEX_FLOW_STRIKES_PER_SIDE=3
# Optional Discord/Slack-compatible webhook for edge-triggered alerts.
GEX_ALERT_WEBHOOK_URL=
GEX_SCAN_MAX_SYMBOLS=40

GEX_LOG_LEVEL=INFO
